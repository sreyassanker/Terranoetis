{
  "name": "Terranoetis Earth Intelligence Platform",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "forwardPorts": [3000, 3001],
  "portsAttributes": {
    "3000": {
      "label": "Terranoetis Client",
      "onAutoForward": "openBrowser"
    },
    "3001": {
      "label": "Terranoetis API",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm install && cp -n .env.example .env || true"
}
