DEEPSEEK_API_KEY=

# ═════════════════════════════════════════════════════════════════
# ADVANCED / ENTERPRISE
# ═════════════════════════════════════════════════════════════════

# Planet Labs (High-res satellite imagery)
# Sign up: https://www.planet.com/
# Paid service with free trial
# Get API key: Account → API Keys
PLANET_API_KEY=

# Maxar (Satellite imagery and analytics)
# Sign up: https://www.maxar.com/
# Enterprise service
# Get credentials: Account team
MAXAR_API_KEY=

# ═════════════════════════════════════════════════════════════════
