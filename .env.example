# Terreanoetis API Configuration
#
# ════════════════════════════════════════════════════════════════════
# SECURITY NOTICE: The credentials below are persisted in plaintext.
# After any commit of this file (or suspected exposure), rotate ALL
# of them: EARTHDATA_*, CESIUM_ION_ACCESS_TOKEN, AIS_STREAM_API_KEY,
# GOOGLE_GEMINI_API_KEY, E2B_API_KEY.  See docs/security.md (TBD).
# ════════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════════
# SERVER CONFIG
# ═════════════════════════════════════════════════════════════════
PROXY_PORT=
JWT_SECRET=
ADMIN_BOOTSTRAP_PASSWORD=
CLIENT_ORIGIN=

# ═════════════════════════════════════════════════════════════════
# NASA EARTHDATA (Precise GNSS satellite orbits — SP3c format)
# ═════════════════════════════════════════════════════════════════
# Sign up: https://urs.earthdata.nasa.gov/
# Free: create an account, no paid tier needed
# Provides sub-decimeter orbit accuracy for ~100 GNSS satellites (GPS/GLONASS/Galileo/BeiDou)
# Used by: CelesTrak TLE → animated SGP4 (covers all 500+ sats)
#          Earthdata SP3 (optional refinement for ~100 GNSS navigation sats)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Earthdata Login (EDL) OAuth2 JWT bearer token for GES DISC downloads
# (GLDAS, etc.) that require a bearer token rather than Basic auth.
# Generated at https://urs.earthdata.nasa.gov/ — valid ~60 days.
EARTHDATA_EDL_TOKEN=

# ═════════════════════════════════════════════════════════════════
# SATELLITE & IMAGERY APIS
# ═════════════════════════════════════════════════════════════════

# Cesium Ion (3D Globe, Terrain, Imagery)
# Sign up: https://ion.cesium.com/signup
# Free tier includes terrain and basic imagery
# Get token: https://ion.cesium.com/tokens
VITE_CESIUM_ION_ACCESS_TOKEN=

# Sentinel Hub (ESA Sentinel-2 satellite imagery)
# Sign up: https://www.sentinel-hub.com/create_account/
# Free trial: 30 days API access
# Get credentials: Dashboard → API Tokens
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Copernicus Data Space Ecosystem (free Sentinel data — instance ID is the auth)
# Sign up: https://dataspace.copernicus.eu/
# Dashboard: https://shapps.dataspace.copernicus.eu/dashboard/ → Configuration Utility
# Create a "Simple WMS Instance" → copy the Instance ID
COPERNICUS_INSTANCE_ID=
# Server-side: base URL for WFS/API calls (defaults to sh.dataspace.copernicus.eu)
COPERNICUS_CLIENT_SECRET=

# NASA FIRMS (Wildfire detection, MODIS/VIIRS)
# Sign up: https://firms.modaps.eosdis.nasa.gov/api/
# Free public API with rate limits
# Get map key: https://firms.modaps.eosdis.nasa.gov/mapserver/
NASA_FIRMS_MAP_KEY=

# ═════════════════════════════════════════════════════════════════
# AVIATION APIS
# ═════════════════════════════════════════════════════════════════

# FlightAware AeroAPI (Premium commercial flight tracking)
# Sign up: https://flightaware.com/commercial/aeroapi/
# Paid API with extensive flight tracking data
# Get API key: https://flightaware.com/commercial/aeroapi/
FLIGHTAWARE_AEROAPI_KEY=

# AirLabs API (Real-time flight data)
# Sign up: https://airlabs.co/
# Free tier available for limited requests
# Get API key: https://airlabs.co/account
AIRLABS_API_KEY=

# ═════════════════════════════════════════════════════════════════
# MARITIME APIS
# ═════════════════════════════════════════════════════════════════

# AISStream (Real-time vessel tracking via AIS)
# Sign up: https://aisstream.io/
# Free trial available, then paid subscription
# Get API key: Dashboard → API Keys
AIS_STREAM_API_KEY=

# MarineTraffic (Alternative vessel tracking)
# Sign up: https://www.marinetraffic.com/en/ais-api-services
# Paid service with free trial
# Get API key: Account → API
MARINE_TRAFFIC_API_KEY=

# ═════════════════════════════════════════════════════════════════
# WEATHER & DISASTER APIS
# ═════════════════════════════════════════════════════════════════

# USGS Earthquakes
# Free public API, no auth required
# Docs: https://earthquake.usgs.gov/fdsnws/event/1/
# Already integrated in server

# NASA EONET (Earth Observation Natural Events Tracking)
# Free public API, no auth required
# Docs: https://eonet.gsfc.nasa.gov/api/v3/
# Already integrated in server

# GDACS (Global Disaster Alert and Coordination System)
# Free RSS feed, no auth required
# Docs: https://www.gdacs.org/
# Already integrated in server

# National Weather Service (NWS) Alerts
# Free public API (US only), no auth required
# Docs: https://api.weather.gov/
# Already integrated in server

# NOAA Space Weather (Kp Index, Solar Storms)
# Free public API, no auth required
# Docs: https://services.swpc.noaa.gov/
# Already integrated in server

