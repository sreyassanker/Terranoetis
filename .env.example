# Frontend (Vite) Environment Variables
# Copy to .env and fill in values
# Only VITE_* vars are exposed to the browser

VITE_CESIUM_ION_ACCESS_TOKEN=
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=

# Intelligence Panel API Keys
# Market Data (Finnhub - free tier available)
# Register at: https://finnhub.io/
FINNHUB_API_KEY=

# Energy Data (US EIA - free tier available)
# Register at: https://www.eia.gov/opendata/
EIA_API_KEY=

# Economic Data (FRED - free tier available)
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CoinGecko (crypto - free tier available)
# Register at: https://www.coingecko.com/en/api
COINGECKO_DEMO_API_KEY=

# Geopolitical Risk (ACLED - free for researchers)
# Register at: https://acleddata.com/
ACLED_ACCESS_TOKEN=

# UCDP Conflict Data (free tier available)
# Register at: https://ucdp.uu.se/apidocs/
UCDP_ACCESS_TOKEN=
