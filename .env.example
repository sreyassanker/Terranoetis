# ═══════════════════════════════════════════════════════════════════
# TERRANOETIS — ENVIRONMENT CONFIGURATION (template)
# ═══════════════════════════════════════════════════════════════════
#
# HOW TO USE THIS FILE
# ────────────────────
# 1. Copy this file to `.env`:   cp .env.example .env
# 2. Fill in only the keys you need. Leave everything else blank.
# 3. The app automatically disables any feature whose key is missing
#    (services degrade gracefully — no crashes).
#
# LAYOUT
# ──────
# PART 1 — CORE & RECOMMENDED: keys used by the reference deployment.
#          Set these first for the full feature set.
# PART 2 — OPTIONAL INTEGRATIONS: additional services, blank by default.
#          Fill in any you use; blank = feature auto-disables.
#
# SECURITY
# ────────
# • Never commit your real `.env` to git — this template ships with no values.
# • Use a strong random JWT_SECRET (32+ chars) in production.
# • If a key is ever exposed, rotate ALL credentials.
# • USGS, NASA EONET, GDACS and NWS are free and need no keys.
# • Rotate keys periodically and monitor usage.

# PART 1 — CORE & RECOMMENDED (set these first for the full feature set)
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# 1. CORE SERVER — REQUIRED for a working deployment
# ═══════════════════════════════════════════════════════════════════

# Port the API server listens on. Leave blank → 3001.
# (Docker Compose also sets PORT=3001 for the container.)
PROXY_PORT=

# Secret used to sign JWT auth tokens.
# Production: REQUIRED, must be ≥ 32 random characters.
# Dev: a random secret is auto-generated with a warning.
JWT_SECRET=

# Password used to create the first "admin" account at startup.
# Production: REQUIRED, must be ≥ 16 characters.
# Dev: auto-generated and logged.
ADMIN_BOOTSTRAP_PASSWORD=

# Allowed browser origin for CORS (e.g. http://localhost:3000).
CLIENT_ORIGIN=


# ═══════════════════════════════════════════════════════════════════
# 2. 3D GLOBE & SATELLITE IMAGERY — make the globe photorealistic
# ═══════════════════════════════════════════════════════════════════

# Cesium Ion access token (enables terrain, imagery, Google Photorealistic 3D Tiles).
# Get one free: https://ion.cesium.com/tokens
VITE_CESIUM_ION_ACCESS_TOKEN=

# Sentinel Hub (ESA Sentinel-2 imagery). Free 30-day trial.
# https://www.sentinel-hub.com/ → Dashboard → API Tokens
SENTINEL_HUB_CLIENT_ID=

SENTINEL_HUB_CLIENT_SECRET=

# Copernicus Data Space (free Sentinel data). The Instance ID acts as auth.
# https://dataspace.copernicus.eu/ → Configuration Utility → Simple WMS Instance
COPERNICUS_INSTANCE_ID=

# Optional server-side auth secret for Copernicus WFS/API calls.
COPERNICUS_CLIENT_SECRET=

# Copernicus Data Space Instance ID for Sentinel-1 SAR / RADAR layers (optional).
COPERNICUS_SAR_INSTANCE_ID=

# NASA FIRMS — wildfire detection (MODIS/VIIRS). Free public key.
# https://firms.modaps.eosdis.nasa.gov/mapserver/  (alias: NASA_FIRMS_MAP_KEY)
NASA_FIRMS_MAP_KEY=

# USGS EROS Registration System — Landsat Collection 2 L1 band-11 access.
# Free registration: https://ers.cr.usgs.gov/register
USGS_ERS_USERNAME=

USGS_ERS_PASSWORD=


# ═══════════════════════════════════════════════════════════════════
# 3. NASA EARTHDATA — precise satellite orbit files (optional refinement)
# ═══════════════════════════════════════════════════════════════════

# Free account: https://urs.earthdata.nasa.gov/
# Used for sub-decimeter GNSS orbit precision (SP3c) for ~100 navigation satellites.
EARTHDATA_USERNAME=

EARTHDATA_PASSWORD=

# Earthdata Login (EDL) OAuth2 bearer token for GES DISC downloads (GLDAS, etc.).
# Generated at https://urs.earthdata.nasa.gov/ — valid ~60 days.
EARTHDATA_EDL_TOKEN=


# ═══════════════════════════════════════════════════════════════════
# 4. AI PROVIDERS — power the agent & cognition (optional; any one works)
# ═══════════════════════════════════════════════════════════════════

# Google Gemini. Free tier: https://ai.google.dev/
GOOGLE_GEMINI_API_KEY=

# Anthropic Claude. Paid: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# Groq (fast inference). Free: https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek (OpenAI-compatible). https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Bai (OpenAI-compatible). https://www.b.ai/
BAI_API_KEY=

# Local LLM via Ollama (no cloud key). Install: https://ollama.ai/ (localhost:11434)
OLLAMA_API_URL=

OLLAMA_MODEL=


# ═══════════════════════════════════════════════════════════════════
# 5. REALTIME VOICE — interruptible audio chat (optional)
# ═══════════════════════════════════════════════════════════════════

# OpenAI Realtime API (primary voice). Keys are kept server-side.
OPENAI_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 6. AVIATION — live flight tracking (optional)
# ═══════════════════════════════════════════════════════════════════

# AirLabs (free tier). https://airlabs.co/account
AIRLABS_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 7. MARITIME — vessel tracking (optional)
# ═══════════════════════════════════════════════════════════════════

# AISStream (real-time AIS). https://aisstream.io/ → Dashboard → API Keys
AIS_STREAM_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 8. WEATHER, OCEAN & DISASTER DATA (optional)
# ═══════════════════════════════════════════════════════════════════

# ECMWF Climate Data Store (ERA5 reanalysis). Free: https://cds.climate.copernicus.eu/
# → API token: https://cds.climate.copernicus.eu/api-how-to
CDS_API_TOKEN=

# Windy.com (webcams + weather viz). Free: https://api.windy.com/
WINDY_API_KEY=

# TomTom (street-level traffic + routing). https://developer.tomtom.com/ → Your API Keys
TOMTOM_API_KEY=

# Electricity Maps (live grid carbon intensity). https://www.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 9. AIR QUALITY & ENVIRONMENT (optional)
# ═══════════════════════════════════════════════════════════════════

# WAQI / World Air Quality Index. Free: https://aqicn.org/data-platform/token/
WAQI_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 10. CYBER THREAT INTELLIGENCE (optional)
# ═══════════════════════════════════════════════════════════════════

# AbuseIPDB (IP abuse lookup). Free 1,000/day: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# AlienVault OTX. Free: https://otx.alienvault.com/api
OTX_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 11. ECONOMIC, FINANCIAL & MARKET DATA (optional)
# ═══════════════════════════════════════════════════════════════════

# FRED (US Federal Reserve data). Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# EIA (US energy data). Free: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Alpha Vantage (stocks/forex/crypto). Free 25/day: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# GoldAPI (precious metals prices). Free 100/day: https://www.goldapi.io/dashboard
GOLDAPI_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 12. NOTIFICATIONS & COMMUNICATIONS (optional)
# ═══════════════════════════════════════════════════════════════════

# ── Gmail SMTP — used to email AI-generated reports ──
# The Gmail address you will send reports FROM (e.g. your-email@gmail.com).
GMAIL_SMTP_USER=

# An App Password for that Gmail account (NOT your normal password).
# Create one: https://myaccount.google.com/apppasswords (needs 2FA enabled).
GMAIL_SMTP_PASS=

# SMTP server host. Default: smtp.gmail.com
GMAIL_SMTP_HOST=

# SMTP port. Default: 465 (SSL).
GMAIL_SMTP_PORT=

# Recipient email address for reports (can be the same as GMAIL_SMTP_USER).
GMAIL_REPORT_TO=


# ═══════════════════════════════════════════════════════════════════
# 13. SOCIAL & NEWS (optional)
# ═══════════════════════════════════════════════════════════════════

# NewsAPI. Free 100/day: https://newsapi.org/account
NEWSAPI_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 14. COMMERCIAL IMAGERY (optional)
# ═══════════════════════════════════════════════════════════════════

# Planet Labs (high-res imagery). Paid: https://www.planet.com/
PLANET_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 15. SANDBOX EXECUTION (optional — running untrusted code)
# ═══════════════════════════════════════════════════════════════════

# E2B sandbox API key (remote code execution).
E2B_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 16. PLATFORM INTEGRATIONS (misc optional)
# ═══════════════════════════════════════════════════════════════════

# Sentry error tracking DSN (unset = no-op). https://sentry.io → project → Settings
SENTRY_DSN=

GIE_API_KEY=

# Cognition pipeline (System2 MCTS) pre-empts tool-calling; disable for data-grounded answers
TERRANOETIS_DISABLE_COGNITION=


# ═══════════════════════════════════════════════════════════════════
# PART 2 — OPTIONAL INTEGRATIONS (blank — features auto-disable gracefully)
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# 1. CORE SERVER — REQUIRED for a working deployment
# ═══════════════════════════════════════════════════════════════════

# Alternative port used by internal services. Usually same as PROXY_PORT.
# Only set separately if you need a different port for internal → server calls.
PORT=

# Runtime environment: development | production | test. Defaults to development.
NODE_ENV=

# Log verbosity: trace | debug | info | warn | error | fatal. Defaults to info.
LOG_LEVEL=

# Optional: Redis connection URL. Leave blank → redis://localhost:6379.
# If Redis is unreachable, the server falls back to SQLite automatically.
REDIS_URL=


# ═══════════════════════════════════════════════════════════════════
# 2. 3D GLOBE & SATELLITE IMAGERY — make the globe photorealistic
# ═══════════════════════════════════════════════════════════════════

# Copernicus Data Space API base URL (advanced). Default: https://sh.dataspace.copernicus.eu
COPERNICUS_API_BASE_URL=

# Copernicus Data Space bearer token for authenticated downloads (optional).
COPERNICUS_TOKEN=

FIRMS_MAP_KEY=


# ═══════════════════════════════════════════════════════════════════
# 3. AI PROVIDERS — power the agent & cognition (optional; any one works)
# ═══════════════════════════════════════════════════════════════════

# Alias some routers check (legacy).
GEMINI_API_KEY=

# OpenRouter (one key, many models). Free: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Other OpenAI-compatible providers (optional).
CEREBRAS_API_KEY=

SAMBANOVA_API_KEY=

TOGETHER_API_KEY=

# Optional Ollama API key if your instance requires one.
OLLAMA_API_KEY=

# Autonomous AI mode: "1" or "true" enables unattended agent actions.
AUTONOMOUS_AI=


# ═══════════════════════════════════════════════════════════════════
# 4. AVIATION — live flight tracking (optional)
# ═══════════════════════════════════════════════════════════════════

# FlightAware AeroAPI (premium). https://flightaware.com/commercial/aeroapi/
FLIGHTAWARE_AEROAPI_KEY=


# ═══════════════════════════════════════════════════════════════════
# 5. MARITIME — vessel tracking (optional)
# ═══════════════════════════════════════════════════════════════════

# MarineTraffic (alternative). https://www.marinetraffic.com/en/ais-api-services
MARINE_TRAFFIC_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 6. WEATHER, OCEAN & DISASTER DATA (optional)
# ═══════════════════════════════════════════════════════════════════

# NOAA space weather — DONKI API (solar flares, CMEs). Free with DEMO_KEY fallback.
# https://api.nasa.gov/
DONKI_API_KEY=

# Copernicus Marine Service (CMEMS) — ocean currents, sea state.
# Free account: https://data.marine.copernicus.eu/
CMEMS_USERNAME=

CMEMS_PASSWORD=

# Cloudflare Radar (outage/network analytics). Free: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_RADAR_API_KEY=

CLOUDFLARE_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 7. AIR QUALITY & ENVIRONMENT (optional)
# ═══════════════════════════════════════════════════════════════════

# OpenAQ (10,000+ global stations). Free: https://docs.openaq.org/using-the-api/api-key
OPENAQ_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 8. CYBER THREAT INTELLIGENCE (optional)
# ═══════════════════════════════════════════════════════════════════

# Shodan (internet exposure search). https://account.shodan.io/
SHODAN_API_KEY=

# VirusTotal (malware/URL scanning). https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 9. ECONOMIC, FINANCIAL & MARKET DATA (optional)
# ═══════════════════════════════════════════════════════════════════

# Finnhub (real-time stock quotes). https://finnhub.io/
FINNHUB_API_KEY=

# ENTSO-E (European electricity transparency). https://transparency.entsoe.eu/
ENTSOE_API_KEY=

# UN Comtrade (international trade). https://comtradeapi.un.org/registration
COMTRADE_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 10. SEARCH & SCRAPING (optional)
# ═══════════════════════════════════════════════════════════════════

# Brave Search. Free 2,000/mo: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Exa (AI search). https://exa.ai/settings/api-keys
EXA_API_KEY=

# Firecrawl (web scraping). Free 500 credits: https://firecrawl.dev/settings
FIRECRAWL_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 11. NOTIFICATIONS & COMMUNICATIONS (optional)
# ═══════════════════════════════════════════════════════════════════

# Telegram bot for push notifications. Create via @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# Resend (transactional email). Free 100/day: https://resend.com/api-keys
RESEND_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 12. CONFLICT & GEOPOLITICS (optional)
# ═══════════════════════════════════════════════════════════════════

# ACLED (armed conflict events). Free with registration: https://acleddata.com/data-export-tool/
ACLED_API_KEY=

# Email used with the ACLED API registration (some endpoints require it).
ACLED_EMAIL=

# UCDP (Uppsala conflict data) access token.
UCDP_ACCESS_TOKEN=


# ═══════════════════════════════════════════════════════════════════
# 13. SOCIAL & NEWS (optional)
# ═══════════════════════════════════════════════════════════════════

# X / Twitter API (live event tweets). https://developer.twitter.com/
TWITTER_API_KEY=

TWITTER_API_SECRET=

TWITTER_BEARER_TOKEN=


# ═══════════════════════════════════════════════════════════════════
# 14. COMMERCIAL IMAGERY (optional)
# ═══════════════════════════════════════════════════════════════════

# Maxar (imagery + analytics). Enterprise: https://www.maxar.com/
MAXAR_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# 15. ADVANCED INFRASTRUCTURE (optional — only if you self-host these)
# ═══════════════════════════════════════════════════════════════════

# TimescaleDB connection string (time-series storage).
TIMESCALE_CONNECTION_STRING=

# ClickHouse HTTP host + port (analytics). Default port: 8123
CLICKHOUSE_HOST=

CLICKHOUSE_PORT=

# Kafka broker list, comma-separated (streaming events).
KAFKA_BROKERS=


# ═══════════════════════════════════════════════════════════════════
# 16. SANDBOX EXECUTION (optional — running untrusted code)
# ═══════════════════════════════════════════════════════════════════

# Token the sandbox expects to authenticate requests.
SANDBOX_API_TOKEN=

# Security gate: allow local code execution. Only set to "true" in dev.
SANDBOX_ALLOW_LOCAL=


# ═══════════════════════════════════════════════════════════════════
# 17. KAGGLE SIMULATION KERNELS (optional — GPU physics runs)
# ═══════════════════════════════════════════════════════════════════

# Kaggle credentials from https://www.kaggle.com/settings/account (Create New Token)
# Saved as Terranoetis_kaggle.json (username + key) — or set explicitly below.
KAGGLE_BIN=

# How often (ms) to poll a running kernel's status. Default 15000.
KAGGLE_POLL_INTERVAL_MS=

# How long (ms) to wait after pushing a kernel before polling. Default 8000.
KAGGLE_POST_PUSH_SETTLE_MS=

# How long (ms) of consecutive errors before a kernel is marked stale. Default 180000.
KAGGLE_STALE_ERROR_GRACE_MS=


# ═══════════════════════════════════════════════════════════════════
# 18. FRONTEND / BUILD (consumed by Vite at build time)
# ═══════════════════════════════════════════════════════════════════

# API base path used by the frontend. Default: /api (proxied by Vite in dev).
VITE_API_PROXY=

# WebSocket URL used by the frontend. Default: ws://<hostname>:3001
VITE_WS_URL=


# ═══════════════════════════════════════════════════════════════════
# 19. PLATFORM INTEGRATIONS (misc optional)
# ═══════════════════════════════════════════════════════════════════

# GitHub token (used for self-evolution / auto-commit features).
GITHUB_TOKEN=

# Metrics endpoint auth token (protects /api/metrics).
METRICS_API_TOKEN=

# Path to a local WLDAS NetCDF file (hydrology analysis).
WLDAS_NC_PATH=

# Path to an EarthGen model checkpoint (generative earth synthesis).
EARTHGEN_CHECKPOINT=
