# ═════════════════════════════════════════════════════════════════
# NOTES
# ═════════════════════════════════════════════════════════════════
# 1. Many APIs have free tiers with rate limits; check their pricing pages
# 2. Some APIs (USGS, NASA EONET, GDACS, NWS) are completely free and public
# 3. Configure only the APIs you plan to use; leave others blank
# 4. The app will gracefully disable features if API keys are missing
# 5. Never commit real API keys to git; use .env instead
# 6. Rotate API keys periodically and monitor usage

E2B_API_KEY=
# SAR Configuration (Sentinel-1 GRD)
COPERNICUS_SAR_INSTANCE_ID=

# ECMWF Climate Data Store (CDS) API v2 Token
# High-fidelity ERA5 reanalysis: friction velocity, TCWV, pressure-level vars, surface fluxes, multi-level soil state
# Register: https://cds.climate.copernicus.eu/ (free) → API token: https://cds.climate.copernicus.eu/api-how-to
CDS_API_TOKEN=

# USGS EROS Registration System (Landsat C2 L1 genuine band-11 access)
USGS_ERS_USERNAME=
USGS_ERS_PASSWORD=

# ── Gmail SMTP for AI email reports ──
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=
GMAIL_SMTP_HOST=
GMAIL_SMTP_PORT=
GMAIL_REPORT_TO=

# TomTom Traffic Flow + Routing — street-level per-vehicle traffic layer
# Register: https://developer.tomtom.com/ → Dashboard → Your API Keys
TOMTOM_API_KEY=

# OpenAI Realtime API — interruptible audio-in/audio-out voice (GEV-parity)
OPENAI_API_KEY=
