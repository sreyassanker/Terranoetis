{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\" \"bash -c 'redis-cli ping &>/dev/null || redis-server 2>/dev/null || true; exec tail -f /dev/null'\"",
    "dev:client": "fuser -k 3000/tcp 2>/dev/null || lsof -ti:3000 | xargs kill -9 2>/dev/null; vite",
    "dev:server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose server/__tests__/unit",
    "test:integration": "vitest run --reporter=verbose server/__tests__/integration",
    "test:e2e": "vitest run --reporter=verbose server/__tests__/e2e",
    "test:server": "vitest run --reporter=verbose server/__tests__/unit server/__tests__/integration",
    "test:server:coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
