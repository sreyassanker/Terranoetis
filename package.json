{
  "name": "terranoetis",
  "version": "3.0.0",
  "description": "Real-time geospatial intelligence platform \u2014 150 peer-reviewed equation engines, AI cognition, and live 3D Earth visualization on Cesium.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "sreyassanker <sreyassanker001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sreyassanker/Terranoetis.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:redis && concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "lsof -ti:3000 | xargs kill -9 2>/dev/null; vite",
    "dev:server": "tsx server/index.ts",
    "dev:redis": "bash -c 'if redis-cli ping &>/dev/null; then echo \"[dev] redis already running\"; exit 0; fi; if command -v redis-server &>/dev/null; then redis-server --daemonize yes && sleep 0.5 && redis-cli ping &>/dev/null && echo \"[dev] redis started\"; else echo \"[dev] warning: redis not found \u2014 server will fall back to SQLite\"; fi'",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run server/__tests__/unit src/__tests__",
    "test:integration": "vitest run server/__tests__/integration server/__tests__/e2e",
    "test:coverage": "vitest run --coverage",
    "claude": "claude",
    "test:ai-chat": "vitest run server/__tests__/unit/aiChatIntent.test.ts && node scripts/aiChatE2E.mjs",
    "test:ai-chat:e2e": "node scripts/aiChatE2E.mjs"
  },
