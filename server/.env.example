# LiveGlobe Server Environment Variables
# Copy to server/.env and fill in your API keys and credentials
# 
# ═════════════════════════════════════════════════════════════════════
# SECURITY NOTICE: Never commit real API keys to git.
# This file is a template — all values should be replaced with your own keys.
# ═════════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════════════
# SERVER CONFIG
# ═════════════════════════════════════════════════════════════════════
PROXY_PORT=3001
JWT_SECRET=                     # Generate: openssl rand -base64 32
ADMIN_BOOTSTRAP_PASSWORD=       # Set a strong password
CLIENT_ORIGIN=http://localhost:3000

# ═════════════════════════════════════════════════════════════════════
# NASA EARTHDATA (Precise GNSS satellite orbits — SP3c format)
# Sign up: https://urs.earthdata.nasa.gov/
# Free: create an account, no paid tier needed
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ═════════════════════════════════════════════════════════════════════
# SATELLITE & IMAGERY APIS
# ═════════════════════════════════════════════════════════════════════

# Cesium Ion (3D Globe, Terrain, Imagery)
# Sign up: https://ion.cesium.com/signup
# Get token: https://ion.cesium.com/tokens
CESIUM_ION_ACCESS_TOKEN=

# Sentinel Hub (ESA Sentinel-2 satellite imagery)
# Sign up: https:// https://www.sentinel-hub.com/create_account/
# Get credentials: Dashboard → API Tokens
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Copernicus Data Space Ecosystem (free, OAuth2)
# Sign up: https://dataspace.copernicus.eu/
# Dashboard: https://shapps.dataspace.copernicus.eu/dashboard/ → OAuth clients
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_INSTANCE_ID=
COPERNICUS_API_BASE_URL=https://sh.dataspace.copernicus.eu
# If you have a Bearer token already, set it here:
COPERNICUS_TOKEN=

# NASA FIRMS (Wildfire detection, MODIS/VIIRS)
# Sign up: https://firms.modaps.eosdis.nasa.gov/api/
# Get map key: https://firms.modaps.eosdis.nasa.gov/mapserver/
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_API_KEY=

# Planet Labs (High-res satellite imagery)
# Sign up: https://www.planet.com/
PLANET_API_KEY=

# ═════════════════════════════════════════════════════════════════════
# AVIATION APIS
# ═════════════════════════════════════════════════════════════════════

# OpenSky Network (higher rate limits with OAuth)
# Sign up: https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FlightAware AeroAPI (Premium commercial flight tracking)
# Sign up: https://flightaware.com/commercial/aeroapi/
FLIGHTAWARE_AEROAPI_KEY=

# AirLabs API (Real-time flight data)
# Sign up: https://airlabs.co/
AIRLABS_API_KEY=

# AviationStack (Flight data, airport ops)
# Sign up: https://aviationstack.com/
AVIATIONSTACK_API=

# ICAO API (NOTAM airport closures)
# Sign up: https://applications.icao.int/
ICAO_API_KEY=

# Travelpayouts (Flight price search)
# Sign up: https://www.travelpayouts.com/
TRAVELPAYOUTS_API_TOKEN=

# Wingbits (Aircraft enrichment)
# Contact: https://wingbits.com/
WINGBITS_API_KEY=

# ═════════════════════════════════════════════════════════════════════
# MARITIME APIS
# ════════════════════════════════════════════════════════════════════

# AISStream (Real-time vessel tracking via AIS)
# Sign up: https://aisstream.io/
AIS_STREAM_API_KEY=

# MarineTraffic (Alternative vessel tracking)
# Sign up: https://www.marinetraffic.com/en/ais-api-services
MARINE_TRAFFIC_API_KEY=

# CorridorRisk (Maritime corridor risk scoring)
# Sign up: https://corridorrisk.io/
CORRIDOR_RISK_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# WEATHER & DISASTER APIS
# ═══════════════════════════════════════════════════════════════════

# OpenAQ (Air quality)
# Sign up: https://docs.openaq.org/using-the-api/api-key
OPENAQ_API_KEY=

# WAQI (World Air Quality Index)
# Sign up: https://aqicn.org/data-platform/token/
WAQI_API_KEY=

# ReliefWeb (Climate disaster news)
# Use a pre-approved app name
RELIEFWEB_APPNAME=

# Windy.com (Webcam imagery)
# Sign up: https://api.windy.com/
WINDY_API_KEY=

# Cloudflare Radar (Internet outages)
# Requires free Cloudflare account with Radar access
CLOUDFLARE_API_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# AI / ANALYTICS APIS
# ═══════════════════════════════════════════════════════════════════

# Google Gemini
# Sign up: https://ai.google.dev/
GOOGLE_GEMINI_API_KEY=

# Anthropic Claude
# Sign up: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq (Fast, free tier: 14,400 req/day)
# Sign up: https://console.groq.com/
GROQ_API_KEY=

# OpenRouter (Fallback AI)
# Sign up: https://openrouter.ai/
OPENROUTER_API_KEY=

# Ollama (Local LLM)
OLLAMA_API_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# ECONOMIC / FINANCIAL DATA
# ═══════════════════════════════════════════════════════════════════

# FRED (Federal Reserve Economic Data)
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# EIA (US Energy Information Administration)
# Sign up: https://www.eia.gov/opendata/
EIA_API_KEY=

# IMF (International Monetary Fund)
# Sign up: https://portal.api.imf.org/
IMF_API_KEY=

# Alpha Vantage (Stock/commodity fallback)
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# CoinGecko (Crypto market data)
# Pro: https://www.coingecko.com/en/api (paid)
# Demo: https://www.coingecko.com/en/api (free)
COINGECKO_API_KEY=
COINGECKO_DEMO_API_KEY=

# GIE AGSI+ (European gas storage)
# Sign up: https://agsi.gie.eu/account
GIE_API_KEY=

# ENTSO-E (EU electricity prices)
# Sign up: https://transparency.entsoe.eu/
ENTSOE_E_TOKEN=

# UN Comtrade (Bilateral trade flows)
# Sign up: https://comtradedeveloper.un.org/
COMTRADE_API_KEYS=

# WTO (Tariff/trade statistics)
# Sign up: https://apiportal.wto.org/
WTO_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# SOCIAL MEDIA & NEWS
# ═══════════════════════════════════════════════════════════════════

# Twitter/X API
# Sign up: https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# NewsAPI
# Sign up: https://newsapi.org/
NEWS_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# CYBER THREAT INTELLIGENCE
# ═══════════════════════════════════════════════════════════════════

# AbuseIPDB
# Sign up: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# AlienVault OTX
# Sign up: https://otx.alienvault.com/api
OTX_API_KEY=

# URLhaus
# Sign up: https://urlhaus.abuse.ch/
URLHAUS_AUTH_KEY=

# ═══════════════════════════════════════════════════════════════════
# SEARCH / SCRAPING
# ═══════════════════════════════════════════════════════════════════

# Exa neural search
# Sign up: https://exa.ai/
EXA_API_KEYS=

# Firecrawl
# Sign up: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# Brave Search
# Sign up: https://brave.com/search/api/
BRAVE_API_KEYS=

# ═══════════════════════════════════════════════════════════════════
# NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════

# Telegram Bot (for push notifications)
# Get from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Resend (Email notifications)
# Sign up: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=WorldMonitor <alerts@worldmonitor.app>
RESEND_FROM_BRIEF=WorldMonitor Brief <brief@worldmonitor.app>

# Discord OAuth (for notification delivery)
# Create app: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Slack OAuth
# Create app: https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# Web Push (VAPID)
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ═══════════════════════════════════════════════════════════════════
# AUTH & SECURITY
# ═══════════════════════════════════════════════════════════════════

# Clerk (User authentication)
# Get from: Clerk Dashboard → API Keys
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Turnstile (CAPTCHA)
# Sign up: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# Session cookie signing
# Generate: openssl rand -hex 32
WM_SESSION_SECRET=

# ═══════════════════════════════════════════════════════════════════
# PAYMENTS (Dodo Payments)
# ═══════════════════════════════════════════════════════════════════

# Get from: https://app.dodopayments.com/ → Settings → API Keys
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_IDENTITY_SIGNING_SECRET=
DODO_BUSINESS_ID=

# ═══════════════════════════════════════════════════════════════════
# INFRASTRUCTURE
# ═══════════════════════════════════════════════════════════════════

# Upstash Redis (Cross-user cache)
# Create: https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Self-hosted Redis (Docker)
REDIS_PASSWORD=
REDIS_TOKEN=

# Supabase (Military bases dataset)
# Create project: https://supabase.com/
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cloudflare R2 (Object storage)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_TRACE_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION=auto

# ═══════════════════════════════════════════════════════════════════
# CONVEX (Database for auth/payments)
# ═══════════════════════════════════════════════════════════════════

CONVEX_URL=
CONVEX_SITE_URL=
CONVEX_SERVER_SHARED_SECRET=

# ═══════════════════════════════════════════════════════════════════
# WORLDMONITOR INTERNAL KEYS
# ════════════════════════════════════════════════════════════════════

# Premium API keys for desktop/cloud fallback
# Generate: openssl rand -hex 24 | sed 's/^/wm_/'
WORLDMONITOR_VALID_KEYS=

# Relay shared secret
# Generate: openssl rand -hex 32
RELAY_SHARED_SECRET=

# MCP Pro grant HMAC
# Generate: openssl rand -base64 32
MCP_PRO_GRANT_HMAC_SECRET=
MCP_INTERNAL_HMAC_SECRET=

# ═══════════════════════════════════════════════════════════════════
# ADVANCED / OPTIONAL
# ═══════════════════════════════════════════════════════════════════

# E2B (Sandbox execution)
# Sign up: https://e2b.dev/
E2B_API_KEY=

# Metrics API token
METRICS_API_TOKEN=

# Sandbox API token
SANDBOX_API_TOKEN=

# Sentry DSN (optional)
SENTRY_DSN=

# Log level
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════
# DEPRECATED / LEGACY (keep for backward compat)
# ═══════════════════════════════════════════════════════════════════

# Legacy key names used in code - prefer new names above
GEMINI_API_KEY=            # Use GOOGLE_GEMINI_API_KEY instead
# ACLED Conflict Data (free registration at acleddata.com)
ACLED_API_KEY=
ACLED_EMAIL=

# CMEMS Ocean Data (free registration at marine.copernicus.eu)
CMEMS_USERNAME=
CMEMS_PASSWORD=
