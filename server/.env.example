# LiveGlobe API Configuration
# Copy this file to .env and fill in your API keys and credentials

# ═════════════════════════════════════════════════════════════════
# SERVER CONFIG
# ═════════════════════════════════════════════════════════════════
PROXY_PORT=3001

# ═════════════════════════════════════════════════════════════════
# SATELLITE & IMAGERY APIS
# ═════════════════════════════════════════════════════════════════

# Cesium Ion (3D Globe, Terrain, Imagery)
# Sign up: https://ion.cesium.com/signup
# Free tier includes terrain and basic imagery
# Get token: https://ion.cesium.com/tokens
CESIUM_ION_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJqdGkiOiIwMjRkMzUzNC00MzBiLTQyYjAtOGE1MC00YzMyNGI3YjYwZjgiLCJpZCI6NDI4NjQ1LCJpc3MiOiJodHRwczovL2lvbi5jZXNpdW0uY29tIiwiYXVkIjoidW5kZWZpbmVkX2RlZmF1bHQiLCJpYXQiOjE3NzgyMDU1ODl9.uhYV0Em1fzuwmTZcUybpOSPPiE4h57duFMGtyjiMBeE

# Sentinel Hub (ESA Sentinel-2 satellite imagery)
# Sign up: https://www.sentinel-hub.com/create_account/
# Free trial: 30 days API access
# Get credentials: Dashboard → API Tokens
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# NASA FIRMS (Wildfire detection, MODIS/VIIRS)
# Sign up: https://firms.modaps.eosdis.nasa.gov/api/
# Free public API with rate limits
# Get map key: https://firms.modaps.eosdis.nasa.gov/mapserver/
NASA_FIRMS_MAP_KEY=

# ═════════════════════════════════════════════════════════════════
# AVIATION APIS
# ═════════════════════════════════════════════════════════════════

# OpenSky Network (Live flight tracking)
# Sign up: https://opensky-network.org/community/
# Free tier: 400 requests/hour, 10 API calls/sec
# Paid tier: higher limits
# Get credentials: https://opensky-network.org/myaccount/profile
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ═════════════════════════════════════════════════════════════════
# MARITIME APIS
# ═════════════════════════════════════════════════════════════════

# AISStream (Real-time vessel tracking via AIS)
# Sign up: https://aisstream.io/
# Free trial available, then paid subscription
# Get API key: Dashboard → API Keys
AIS_STREAM_API_KEY=

# MarineTraffic (Alternative vessel tracking)
# Sign up: https://www.marinetraffic.com/en/ais-api-services
# Paid service with free trial
# Get API key: Account → API
MARINE_TRAFFIC_API_KEY=

# ═════════════════════════════════════════════════════════════════
# WEATHER & DISASTER APIS
# ═════════════════════════════════════════════════════════════════

# USGS Earthquakes
# Free public API, no auth required
# Docs: https://earthquake.usgs.gov/fdsnws/event/1/
# Already integrated in server

# NASA EONET (Earth Observation Natural Events Tracking)
# Free public API, no auth required
# Docs: https://eonet.gsfc.nasa.gov/api/v3/
# Already integrated in server

# GDACS (Global Disaster Alert and Coordination System)
# Free RSS feed, no auth required
# Docs: https://www.gdacs.org/
# Already integrated in server

# National Weather Service (NWS) Alerts
# Free public API (US only), no auth required
# Docs: https://api.weather.gov/
# Already integrated in server

# NOAA Space Weather (Kp Index, Solar Storms)
# Free public API, no auth required
# Docs: https://services.swpc.noaa.gov/
# Already integrated in server

# ═════════════════════════════════════════════════════════════════
# AI / ANALYTICS APIS (Optional)
# ═════════════════════════════════════════════════════════════════

# Google Gemini (For advanced event analysis)
# Sign up: https://ai.google.dev/
# Free tier: 60 requests/min
# Get API key: https://ai.google.dev/
GOOGLE_GEMINI_API_KEY=

# Anthropic Claude (Alternative AI for analysis)
# Sign up: https://console.anthropic.com/
# Paid service with usage-based billing
# Get API key: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# ═════════════════════════════════════════════════════════════════
# ADVANCED / ENTERPRISE
# ═════════════════════════════════════════════════════════════════

# Planet Labs (High-res satellite imagery)
# Sign up: https://www.planet.com/
# Paid service with free trial
# Get API key: Account → API Keys
PLANET_API_KEY=

# Maxar (Satellite imagery and analytics)
# Sign up: https://www.maxar.com/
# Enterprise service
# Get credentials: Account team
MAXAR_API_KEY=

# ═════════════════════════════════════════════════════════════════
# SOCIAL MEDIA & NEWS (Optional, for intel feed)
# ═════════════════════════════════════════════════════════════════

# Twitter/X API (For live disaster tweets)
# Sign up: https://developer.twitter.com/
# Free tier: v2 Essential access
# Get credentials: Dashboard → Keys & Tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# NewsAPI (For news aggregation)
# Sign up: https://newsapi.org/
# Free tier: 100 requests/day
# Get API key: https://newsapi.org/account
NEWS_API_KEY=

# ═════════════════════════════════════════════════════════════════
# CAMERA & STREAMING SERVICES (Optional)
# ═════════════════════════════════════════════════════════════════

# OpenCCTV (Public camera aggregator)
# Sign up: https://opencctv.org/
# Free public API, no auth typically required for basic queries
# Already integrated in server

# HLS.js support (for M3U8 stream playback)
# No auth required, client-side library
# Already integrated in frontend

# ═════════════════════════════════════════════════════════════════
# NOTES
# ═════════════════════════════════════════════════════════════════
# 1. Many APIs have free tiers with rate limits; check their pricing pages
# 2. Some APIs (USGS, NASA EONET, GDACS, NWS) are completely free and public
# 3. Configure only the APIs you plan to use; leave others blank
# 4. The app will gracefully disable features if API keys are missing
# 5. Never commit real API keys to git; use .env instead
# 6. Rotate API keys periodically and monitor usage
