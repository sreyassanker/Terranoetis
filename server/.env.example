# ═════════════════════════════════════════════════════════════════
# Realtime_v2 — Environment Configuration
# ═════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your keys:
#   cp server/.env.example server/.env
# The app starts with missing non-critical keys; features degrade gracefully.

# ═════════════════════════════════════════════════════════════════
# REQUIRED — App will warn on startup if missing
# ═════════════════════════════════════════════════════════════════
JWT_SECRET=your-jwt-secret-here
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GEMINI_API_KEY=backup-gemini-key
CLIENT_ORIGIN=http://localhost:5173
PROXY_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
METRICS_API_TOKEN=your-metrics-token

# ═════════════════════════════════════════════════════════════════
# OPTIONAL — Sandbox (E2B / custom)
# ═════════════════════════════════════════════════════════════════
SANDBOX_API_TOKEN=your-sandbox-token
E2B_API_KEY=your-e2b-key

# ═════════════════════════════════════════════════════════════════
# OPTIONAL — Satellite & Imagery
# ═════════════════════════════════════════════════════════════════
CESIUM_ION_ACCESS_TOKEN=your-cesium-token
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
NASA_FIRMS_MAP_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ═════════════════════════════════════════════════════════════════
# OPTIONAL — Aviation
# ═════════════════════════════════════════════════════════════════
FLIGHTAWARE_AEROAPI_KEY=
AIRLABS_API_KEY=

# ═════════════════════════════════════════════════════════════════
# OPTIONAL — Maritime
# ═════════════════════════════════════════════════════════════════
AIS_STREAM_API_KEY=
MARINE_TRAFFIC_API_KEY=

# ═════════════════════════════════════════════════════════════════
# OPTIONAL — AI / Analytics
# ═════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=

# ═════════════════════════════════════════════════════════════════
# OPTIONAL — Satellite Imagery (Enterprise)
# ═════════════════════════════════════════════════════════════════
PLANET_API_KEY=
MAXAR_API_KEY=

# ═════════════════════════════════════════════════════════════════
# OPTIONAL — Social / News (Intel feed)
# ═════════════════════════════════════════════════════════════════
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
NEWS_API_KEY=

# ═════════════════════════════════════════════════════════════════
# NOTES
# ═════════════════════════════════════════════════════════════════
# 1. Many APIs (USGS, NASA EONET, GDACS, NWS) are free and public — no key needed
# 2. Configure only what you plan to use; leave others blank
# 3. The app gracefully disables features if keys are missing
# 4. Never commit real API keys to git; use .env instead
